generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  displayName    String
  passwordHash   String
  sharingEnabled Boolean  @default(true)
  avatarColor    String   @default("#10b981")
  avatarPath     String?
  bannerPath     String?
  theme          String   @default("light") // light | dark | system
  fontPref       String   @default("default") // default | atkinson | opendyslexic
  iconStyle      String   @default("normal") // normal | thin | bold | sharp
  isAdmin        Boolean  @default(false)
  disabled       Boolean  @default(false)
  createdAt      DateTime @default(now())

  sentRequests      Friendship[]    @relation("requester")
  receivedRequests  Friendship[]    @relation("addressee")
  ownedFamilies     Family[]        @relation("owner")
  familyMemberships FamilyMember[]
  location          Location?
  locationHistory   LocationHistory[]
  geofences         Geofence[]      @relation("geofenceOwner")
  watchedIn         GeofenceWatch[] @relation("watchedUser")
  notifications     Notification[]
  deviceTokens      DeviceToken[]
  conversations     ConversationMember[]
  sentMessages      Message[]
}

model Geofence {
  id            String   @id @default(cuid())
  ownerId       String
  name          String
  lat           Float
  lng           Float
  radius        Float // metre
  notifyOnEnter Boolean  @default(true)
  notifyOnExit  Boolean  @default(true)
  createdAt     DateTime @default(now())

  owner   User            @relation("geofenceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  watches GeofenceWatch[]

  @@index([ownerId])
}

model GeofenceWatch {
  id         String   @id @default(cuid())
  geofenceId String
  userId     String // izlenen kullanici
  inside     Boolean? // son bilinen durum (null = henuz bilinmiyor)
  createdAt  DateTime @default(now())

  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  user     User     @relation("watchedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([geofenceId, userId])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String // alici
  title     String
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // android | web
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("pending") // pending | accepted
  createdAt   DateTime @default(now())

  requester User @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Family {
  id         String   @id @default(cuid())
  name       String
  ownerId    String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  owner        User           @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      FamilyMember[]
  conversation Conversation?
}

model Conversation {
  id        String   @id @default(cuid())
  type      String // direct | family | group
  name      String? // group / family icin
  familyId  String?  @unique
  createdAt DateTime @default(now())

  family   Family?              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AppSettings {
  id        String   @id
  appName   String   @default("PaperMap")
  logoPath  String?
  updatedAt DateTime @updatedAt
}

model FamilyMember {
  id       String   @id @default(cuid())
  familyId String
  userId   String
  role     String   @default("member") // owner | member
  joinedAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

model Location {
  userId    String   @id
  lat       Float
  lng       Float
  accuracy  Float?
  battery   Int?
  charging  Boolean?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Konum gecmisi — kisitlamali kaydedilir, ~1 ay (30 gun) saklanir
model LocationHistory {
  id         String   @id @default(cuid())
  userId     String
  lat        Float
  lng        Float
  accuracy   Float?
  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}
