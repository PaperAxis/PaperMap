# --- PostgreSQL ---
POSTGRES_USER=papermap
POSTGRES_PASSWORD=papermap_dev_password
POSTGRES_DB=papermap

# --- Backend (server) ---
# Docker icinde host adi "db" olur. Lokal calistirirsaniz "localhost" yapin.
DATABASE_URL=postgresql://papermap:papermap_dev_password@db:5432/papermap?schema=public
# ZORUNLU: en az 32 karakter rastgele bir deger. Ornek uretim:
#   openssl rand -hex 32
# Varsayilan/kisa birakilirsa sunucu acilista hata verip durur.
JWT_SECRET=
PORT=4015
# Tarayicidan API'ye erisecek origin'ler (virgulle ayrilir). Mobil uygulama
# (Capacitor) origin'leri zaten otomatik izinlidir. Bos birakilirsa tum
# origin'lere izin verilir (acilista uyari gosterilir).
# Uretim ornegi: https://maps.paperaxis.com
ALLOWED_ORIGINS=
# Bu e-postalarla giris yapan kullanicilar otomatik yonetici (superadmin) olur.
# Virgulle ayirin. Once kayit olun, sonra buraya ekleyip server'i yeniden baslatin.
ADMIN_EMAILS=

# --- Frontend (web, build-time) ---
# Tarayicidan/APK'dan erisilecek backend adresi.
# Yerel gelistirme: http://localhost:4015
# Uretim (VDS): https://maps.paperaxis.com
VITE_API_URL=http://localhost:4015

# --- Konteyner port baglama (host arayuzu) ---
# 127.0.0.1: portlar yalnizca ayni makineden erisilir (reverse proxy ayni VDS'te).
# 0.0.0.0  : portlar disariya/LAN'a acilir (or. telefonla yerel testte).
BIND_HOST=127.0.0.1

# Konteynerlerin HOST tarafindaki portlari. Reverse proxy Docker aginda ise
# bu portlara gerek yoktur (yalnizca yerel hata ayiklama icindir).
# Host'ta bu portlardan biri doluysa serbest bir degerle degistirin.
WEB_HOST_PORT=8080
SERVER_HOST_PORT=4015
