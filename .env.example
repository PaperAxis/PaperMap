# --- PostgreSQL ---
POSTGRES_USER=papermap
POSTGRES_PASSWORD=papermap_dev_password
POSTGRES_DB=papermap

# --- Backend (server) ---
# Docker icinde host adi "db" olur. Lokal calistirirsaniz "localhost" yapin.
DATABASE_URL=postgresql://papermap:papermap_dev_password@db:5432/papermap?schema=public
# ZORUNLU: en az 32 karakter rastgele bir deger. Ornek uretim:
#   openssl rand -hex 32
# Varsayilan/kisa birakilirsa sunucu acilista hata verip durur.
JWT_SECRET=
PORT=4015
# Tarayicidan API'ye erisecek origin'ler (virgulle ayrilir). Native mobil
# uygulamalar Origin gondermez, bu listeden etkilenmez. Bos birakilirsa tum
# origin'lere izin verilir (acilista uyari gosterilir).
# Uretim ornegi: https://maps.paperaxis.com
ALLOWED_ORIGINS=
# Bu e-postalarla giris yapan kullanicilar otomatik yonetici (superadmin) olur.
# Virgulle ayirin. Once kayit olun, sonra buraya ekleyip server'i yeniden baslatin.
ADMIN_EMAILS=

# --- E-posta (SMTP) ---
# Sifre sifirlama ve e-posta dogrulama icin gereklidir. SMTP_HOST bos
# birakilirsa e-posta gonderimi atlanir (akislar kirilmaz; sifirlama
# baglantisi sunucu loguna yazilir). SMTP saglayicisi ekleyince doldurun.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Gonderen adresi (or. "PaperMap <noreply@paperaxis.com>")
SMTP_FROM=
# Mail sunucusu kendinden-imzali (self-signed) TLS sertifikasi kullaniyorsa
# "true" yapin (TLS dogrulamasi kapanir; sadece kendi guvendiginiz sunucuda).
# En iyisi mail sunucusuna gecerli (Let's Encrypt) sertifika kurmaktir.
SMTP_ALLOW_SELF_SIGNED=false
# E-posta baglantilarinda kullanilan genel web adresi (sifre sifirlama
# linki bunun uzerine kurulur). Bos birakilirsa ALLOWED_ORIGINS'in ilki
# kullanilir. Uretim ornegi: https://maps.paperaxis.com
APP_URL=

# --- Google / PaperApp ile giris (docs/SSO.md) ---
# Bos birakilan saglayici kapali; dugmesi gosterilmez. APP_URL https olmali.
# Google Cloud Console > Credentials > OAuth client ID (Web application),
# Authorized redirect URI: https://maps.paperaxis.com/api/sso/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PaperApp OIDC; PaperApp .env'deki OIDC_CLIENT_PAPERMAP_* ile eslesir.
# Donus adresi: https://maps.paperaxis.com/api/sso/paperapp/callback
PAPERAPP_ISSUER=
PAPERAPP_CLIENT_ID=papermap
PAPERAPP_CLIENT_SECRET=

# --- Frontend (web, build-time) ---
# Tarayicidan/APK'dan erisilecek backend adresi.
# Yerel gelistirme: http://localhost:4015
# Uretim (VDS): https://maps.paperaxis.com
VITE_API_URL=http://localhost:4015

# --- Harita verisi (istege bagli) ---
# Bos: vektor harita VDS'teki tileserver'dan (tiles/turkey.mbtiles) sunulur.
# Dolu: tum dunya haritasi statik hosting'deki tek PMTiles dosyasindan okunur
# (kurulum: scripts/publish-world-tiles.sh). Fontlar varsayilan olarak ayni
# adresin /fonts klasorundedir; farkliysa VITE_GLYPHS_URL ile verin.
# Ornek: VITE_TILES_PMTILES=https://tiles.paperaxis.com/planet.pmtiles
VITE_TILES_PMTILES=
VITE_GLYPHS_URL=

# --- Konteyner port baglama (host arayuzu) ---
# 127.0.0.1: portlar yalnizca ayni makineden erisilir (reverse proxy ayni VDS'te).
# 0.0.0.0  : portlar disariya/LAN'a acilir (or. telefonla yerel testte).
BIND_HOST=127.0.0.1

# Konteynerlerin HOST tarafindaki portlari. Reverse proxy Docker aginda ise
# bu portlara gerek yoktur (yalnizca yerel hata ayiklama icindir).
# Host'ta bu portlardan biri doluysa serbest bir degerle degistirin.
WEB_HOST_PORT=8080
SERVER_HOST_PORT=4015
